# Copy these into your hosting provider's "Environment Variables" (never commit real values).

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# PostgreSQL connection string from your database provider
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Private file storage (S3-compatible: AWS S3, Cloudflare R2, Supabase Storage)
USE_S3=1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Optional
HELPDESK_ENABLED=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
